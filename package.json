{
  "name": "dewnote",
  "private": true,
  "version": "0.0.0",
  "description": "A minimal editor for notebooks written as markdown: prose, LaTeX maths, and code cells that run in the page.",
  "type": "module",
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "dev": "bun --hot ./index.html",
    "build": "bun build ./index.html --outdir dist --minify && bun scripts/inline-single-file.ts",
    "test:e2e": "bun run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.0",
    "@types/markdown-it": "^14.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "js-yaml": "^5.4.1",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.1",
    "markdown-it-texmath": "^1.0.0"
  }
}
